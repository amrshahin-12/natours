e":45,"column":31}},{"generated":{"line":48,"column":45},"source":"leafletMap.js","original":{"line":45,"column":32},"name":"points"},{"generated":{"line":48,"column":51},"source":"leafletMap.js","original":{"line":45,"column":38}},{"generated":{"line":48,"column":52},"source":"leafletMap.js","original":{"line":45,"column":39}},{"generated":{"line":48,"column":53},"source":"leafletMap.js","original":{"line":45,"column":40},"name":"pad"},{"generated":{"line":48,"column":56},"source":"leafletMap.js","original":{"line":45,"column":43}},{"generated":{"line":48,"column":57},"source":"leafletMap.js","original":{"line":45,"column":44}},{"generated":{"line":48,"column":60},"source":"leafletMap.js","original":{"line":45,"column":47}},{"generated":{"line":48,"column":61},"source":"leafletMap.js","original":{"line":45,"column":48}},{"generated":{"line":50,"column":2},"source":"leafletMap.js","original":{"line":47,"column":2}},{"generated":{"line":51,"column":2},"source":"leafletMap.js","original":{"line":48,"column":2}},{"generated":{"line":52,"column":2},"source":"leafletMap.js","original":{"line":49,"column":2},"name":"map"},{"generated":{"line":52,"column":5},"source":"leafletMap.js","original":{"line":49,"column":5}},{"generated":{"line":52,"column":6},"source":"leafletMap.js","original":{"line":49,"column":6},"name":"fitBounds"},{"generated":{"line":52,"column":15},"source":"leafletMap.js","original":{"line":49,"column":15}},{"generated":{"line":52,"column":16},"source":"leafletMap.js","original":{"line":49,"column":16},"name":"bounds"},{"generated":{"line":52,"column":22},"source":"leafletMap.js","original":{"line":49,"column":22}},{"generated":{"line":52,"column":23},"source":"leafletMap.js","original":{"line":49,"column":23}},{"generated":{"line":53,"column":0},"source":"leafletMap.js","original":{"line":50,"column":0}},{"generated":{"line":53,"column":1},"source":"leafletMap.js","original":{"line":50,"column":1}}],"sources":{"leafletMap.js":"/* eslint-disable */\r\nimport L from 'leaflet';\r\nimport 'leaflet/dist/leaflet.css';\r\n\r\nexport const displayMap = (locations) => {\r\n  //create a new interactive map, and render it inside the element with id 'map'\r\n  const map = L.map('map', {\r\n    scrollWheelZoom: false,\r\n  });\r\n\r\n  //L.tileLayer(url, options) — creates a \"layer\" that knows how to fetch and display tile images\r\n  L.tileLayer(\r\n    'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=cb1_3hnr_1_7919a6022668d9eb950535ab',\r\n    {\r\n      attribution: '&copy; OpenStreetMap contributors &copy; CARTO',\r\n    },\r\n  ).addTo(map);\r\n  //.addTo(map) — attaches this tile layer to your map object, so it renders.\r\n\r\n  // Custom marker icon using existing .marker CSS class\r\n  const customIcon = L.divIcon({\r\n    className: 'marker',\r\n    iconSize: [20, 25],\r\n    iconAnchor: [16, 40], // bottom-center of the pin touches the actual location\r\n    popupAnchor: [0, -40], // popup opens above the pin tip, not through it\r\n  });\r\n\r\n  const points = []; //will fill the array with the locations\r\n\r\n  locations.forEach((loc) => {\r\n    points.push([loc.coordinates[1], loc.coordinates[0]]);\r\n\r\n    //creates an actual marker pin at that specific coordinate\r\n    L.marker([loc.coordinates[1], loc.coordinates[0]], { icon: customIcon })\r\n      .addTo(map)\r\n      .bindPopup(`<p>Day ${loc.day}: ${loc.description}</p>`, {\r\n        autoClose: false,\r\n        // closeOnClick: false, // Prevents closing when clicking on the map\r\n      })\r\n      .openPopup();\r\n  });\r\n\r\n  //takes your array of [lat, lng] pairs\r\n  //and calculates the smallest rectangular box that contains all of them.\r\n  const bounds = L.latLngBounds(points).pad(0.5);\r\n\r\n  //instead of hardcoding fixed center\r\n  //dynamically calc it based on tours coordinates\r\n  map.fitBounds(bounds);\r\n};\r\n"},"lineCount":null}},"error":null,"hash":"e5c57929a6688679793d2c492ac01ac4","cacheData":{"env":{}}}